# ─── Required ────────────────────────────────────────────────────────────────

# Wallbit brokerage API key (https://wallbit.io)
WALLBIT_API_KEY=your_wallbit_api_key_here

# Anthropic API key — used by the Lucius agent (Sonnet) and guard (Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Trading mode ─────────────────────────────────────────────────────────────

# Set to true to simulate all trades without sending real orders to the broker.
# Useful for testing the full flow without moving real money. (default: false)
DRY_RUN=false

# Set to true to enable paper-trading mode with a virtual balance.
# All buys/sells are recorded locally; no real orders are placed. (default: false)
SIM_MODE=false

# Starting balance for simulation mode in USD. Only applied when initializing
# a fresh sim state or after a reset. (default: 0)
SIM_BALANCE=10000

# ─── Storage paths ────────────────────────────────────────────────────────────

# Path to the user investment profile JSON. (default: profile.json)
# PROFILE_FILE=profile.json

# Path to the simulation state JSON. (default: sim-state.json)
# SIM_STATE_FILE=sim-state.json
